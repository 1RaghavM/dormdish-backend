# Backend environment variables (Brevo/Sendinblue)

# Brevo API key (required)
BREVO_API_KEY=your_brevo_api_key
# Default list ID to add contacts to (optional)
BREVO_LIST_ID=123
# Sender info for transactional emails
BREVO_FROM_EMAIL=inquiries@dormdish.ai
BREVO_FROM_NAME=DormDish
# Transactional template ID (number) used for welcome/confirmation emails
BREVO_TEMPLATE_ID=1

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Optional: OpenAI compatible API
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lm-studio

# Cloudflare Turnstile secret (server-side). When unset, captcha verification is skipped in dev.
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
