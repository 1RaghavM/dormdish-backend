{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "env": {
    "PYTHONPATH": "."
  },
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/send-daily-reminders",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/cron/refresh-menus",
      "schedule": "0 9 * * *"
    }
  ]
}
