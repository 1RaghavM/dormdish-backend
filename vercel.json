{
  "version": 2,
  "buildCommand": "python optimize_dependencies.py || true",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "env": {
    "PYTHONPATH": "."
  },
  "regions": ["iad1"],
  "crons": [{
      "path": "/api/send-daily-reminders",
      "schedule": "0 10 * * *"
    }],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  }
}