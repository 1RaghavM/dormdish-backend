{
  "version": 2,
  "buildCommand": "bash vercel-build || true",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "env": {
    "PYTHONPATH": "."
  },
  "regions": ["iad1"],
  "crons": [{
      "path": "/api/send-daily-reminders",
      "schedule": "0 10 * * *"
    }]
}