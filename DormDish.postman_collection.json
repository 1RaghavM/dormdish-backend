    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register (optional)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "const code = pm.response.code;",
                  "",
                  "// Capture token if registration succeeded",
                  "if (code === 200 && json && json.session_token) {",
                  "  pm.collectionVariables.set('sessionToken', json.session_token);",
                  "}",
                  "if (code === 200 && json && json.user && json.user.id) {",
                  "  pm.collectionVariables.set('userId', json.user.id);",
                  "}",
                  "",
                  "// Treat \"already exists\" as acceptable when rerunning tests",
                  "pm.test('Register succeeded (or account already exists)', function () {",
                  "  if (code === 200) {",
                  "    pm.expect(json).to.have.property('success');",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json).to.have.property('session_token');",
                  "  } else if (code === 400) {",
                  "    const msg = (json && (json.message || json.detail)) ? String(json.message || json.detail) : '';",
                  "    pm.expect(msg.toLowerCase()).to.include('already exists');",
                  "  } else {",
                  "    pm.expect(code, 'Unexpected HTTP status for register').to.be.oneOf([200, 400]);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"age\": 20,\n  \"height_feet\": 5,\n  \"height_inches\": 10,\n  \"weight_lbs\": 170,\n  \"gender\": \"male\",\n  \"activity_level\": \"moderately_active\",\n  \"goal\": \"maintain\",\n  \"university\": \"rutgers\",\n  \"dietary_preference\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
